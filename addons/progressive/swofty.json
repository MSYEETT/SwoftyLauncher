{
  "schema_version": 1,
  "id": "swofty.progressive",
  "name": "Progressive Career",
  "version": "0.2.0",
  "author": "Swofty",
  "description": "A Driver Career that starts in any season from 2016 to 2026 as a real driver and moves through the real seasons: each year's cars, liveries, helmets and line-ups, then 2026 from there on.",
  "license": "AGPL-3.0-or-later",
  "category": "seasons",
  "kind": [
    "native",
    "database",
    "erp",
    "text"
  ],
  "compat": {
    "game": "f1_25",
    "game_builds": [
      ">=25251167"
    ],
    "seasons": [
      "f1_2026"
    ],
    "launcher": ">=1.5.12"
  },
  "requires": [
    {
      "id": "swofty.core",
      "version": ">=0.2.13"
    },
    {
      "id": "swofty.classic-seasons",
      "version": ">=0.5.1"
    },
    {
      "id": "swofty.classic-seasons-2016",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2017",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2018",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2019",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2020",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2021",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2022",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2023",
      "version": ">=0.5.2"
    },
    {
      "id": "swofty.classic-seasons-2024",
      "version": ">=0.5.2"
    }
  ],
  "saves": {
    "affects": true,
    "message": "Progressive careers won't load without it."
  },
  "options": [
    {
      "id": "start_season",
      "type": "choice",
      "label": "Starting season",
      "description": "The real season a new Progressive career starts in. Each new season moves on a year, up to 2026.",
      "default": "2026",
      "values": [
        "2016",
        "2017",
        "2018",
        "2019",
        "2020",
        "2021",
        "2022",
        "2023",
        "2024",
        "2025",
        "2026"
      ],
      "binds": "native",
      "hidden": true
    },
    {
      "id": "rnd_mode",
      "type": "choice",
      "label": "R&D",
      "description": "Real life: each season's car brings that year's pace, with no R&D. Hybrid: R&D on top of the year's car, with a per-season budget from the team's real pace. You can change it at any time; it applies to the loaded career.",
      "default": "real_life",
      "values": [
        {
          "value": "real_life",
          "label": "Real life"
        },
        {
          "value": "hybrid",
          "label": "Hybrid"
        }
      ],
      "binds": "native",
      "hidden": true
    },
    {
      "id": "team_moves",
      "type": "choice",
      "label": "Team moves",
      "description": "Follow your driver's real career from team to team, or choose your team from the offers.",
      "default": "follow_driver",
      "values": [
        {
          "value": "follow_driver",
          "label": "Follow your driver's real career"
        },
        {
          "value": "choose",
          "label": "Choose your team"
        }
      ],
      "binds": "native",
      "hidden": true
    },
    {
      "id": "season_visuals",
      "type": "toggle",
      "label": "Season cars and helmets",
      "description": "Each season also brings that year's cars, liveries and helmets.",
      "default": true,
      "binds": "native"
    },
    {
      "id": "test_next_season",
      "type": "toggle",
      "label": "Developer: next season now",
      "description": "Developer test: the next Team HQ of a Progressive career applies the following season's line-ups, cars and looks without racing the season. Turn it off and on again for another season. Leave off.",
      "default": false,
      "binds": "native",
      "hidden": true
    },
    {
      "id": "dev_probe",
      "type": "toggle",
      "label": "Developer: seat probe",
      "description": "Developer test: applies data/probe.json seat writes at Team HQ in any Driver Career. Leave off.",
      "default": false,
      "binds": "native",
      "hidden": true
    }
  ],
  "career_setup": {
    "route": "career_wizard_driver_career_progressive",
    "title": "Progressive Career",
    "options": [
      "start_season",
      "rnd_mode",
      "team_moves"
    ]
  },
  "hub_tab": {
    "name": "progressive",
    "title": "Progressive Settings",
    "options": [
      "rnd_mode"
    ],
    "data_group": "f1_career_progressive"
  },
  "operations": {
    "database": [
      "db/career.json",
      "db/grid.json"
    ],
    "erp": [
      "erp/wizard.json"
    ],
    "assets": [
      "lang/career.json"
    ],
    "native": [
      {
        "dll": "native/progressive_ui.dll"
      },
      {
        "dll": "native/progressive_suffix.dll"
      },
      {
        "dll": "native/progressive_back.dll"
      },
      {
        "dll": "native/progressive_rnd.dll"
      },
      {
        "dll": "native/progressive_follow.dll"
      },
      {
        "dll": "native/progressive_cards.dll"
      },
      {
        "dll": "native/progressive.dll",
        "files": [
          "data/"
        ]
      }
    ]
  }
}
